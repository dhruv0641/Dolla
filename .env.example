# Copy to .env for local use. Never put real credentials in this file or commit .env.
FLOWX_ENVIRONMENT=development
FLOWX_LOG_LEVEL=INFO
FLOWX_STORAGE_ROOT=./data

# Local Docker Compose profile. Services bind to loopback by default.
FLOWX_API_HOST=127.0.0.1
FLOWX_API_PORT=8000
FLOWX_WEB_HOST=127.0.0.1
FLOWX_WEB_PORT=3000

# References only. Resolve these through an OS secret store in a later integration task.
FLOWX_DATABASE_CREDENTIALS_REF=secretref://os-store/flowx/dev/database
FLOWX_GEMINI_CREDENTIALS_REF=secretref://os-store/flowx/dev/gemini
FLOWX_FLOW_CREDENTIALS_REF=secretref://os-store/flowx/dev/flow-account
FLOWX_YOUTUBE_CREDENTIALS_REF=secretref://os-store/flowx/dev/youtube
# External publishing remains disabled unless an owner authorizes a deployment.
FLOWX_YOUTUBE_PUBLISHING_ENABLED=false
FLOWX_META_CREDENTIALS_REF=secretref://os-store/flowx/dev/meta
FLOWX_INSTAGRAM_PUBLISHING_ENABLED=false
FLOWX_FACEBOOK_PUBLISHING_ENABLED=false
FLOWX_PLATFORM_RECONCILIATION_ENABLED=false
FLOWX_PUBLICATION_SCHEDULING_ENABLED=false
FLOWX_PLATFORM_ANALYTICS_ENABLED=false
